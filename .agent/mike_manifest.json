{
  "$schema": "https://mike-llc-ct.web.app/schemas/mike-manifest.v1.json",
  "name": "Minimal_Intelligent_Kuota_Extension",
  "display_name": "Minimal Intelligent Kuota Extension",
  "archetype": "VS Code / IDE Extension",
  "description": "Minimal Intelligent Kuota Extension",
  "git": {
    "remote": "https://github.com/mdziejma/Minimal_Intelligent_Kuota_Extension.git",
    "default_branch": "Development_8"
  },
  "cloud": {
    "primary_project_id": null,
    "billing_plan": "None",
    "all_gcp_projects": [],
    "hosting_targets": [],
    "hosting_urls": [],
    "has_firestore": false,
    "has_realtime_db": false,
    "has_storage": false,
    "has_cloud_run": false
  },
  "ai_runtime": {
    "has_ai": false,
    "sdks": [],
    "auth_methods": [],
    "models_in_use": {},
    "deprecation_watch": []
  },
  "agent_harness": {
    "primary_agent": "antigravity-white",
    "mcp_servers": [
      "file-writer"
    ],
    "active_skills": [
      "audio_design"
    ],
    "context_budget": "128k"
  },
  "env_contract": {
    "required_vars": [
      "OVSX_PAT",
      "VSCE_PAT"
    ],
    "sample_file": null
  },
  "security_watch": {
    "active_cves": [],
    "audit_status": "clean"
  },
  "compute": {
    "requires_gpu": false,
    "gpu_frameworks": []
  },
  "subcomponents": [
    {
      "name": "scripts",
      "type": "local_scripts",
      "path": "scripts"
    }
  ],
  "actions": {
    "build": {
      "label": "\ud83d\udd28 Build",
      "command": "npm run compile",
      "tooltip": "Bundle TypeScript sources into ./dist/extension.js."
    },
    "test": {
      "label": "\ud83e\uddea Run Tests",
      "command": "npm test",
      "tooltip": "Run Unit Tests & Lint"
    },
    "debug": {
      "label": "\ud83d\udc1b Debug Extension",
      "command": "workbench.action.debug.start",
      "tooltip": "Launch Extension Host Debugger (F5)"
    },
    "package": {
      "label": "\ud83d\udce6 Package VSIX",
      "command": "npm run package",
      "tooltip": "Compile and package standalone .vsix extension bundle."
    },
    "publish_ovsx": {
      "label": "\ud83c\udf10 Publish Open VSX",
      "command": "npm run publish:ovsx",
      "tooltip": "Publish packaged VSIX artifact to Open VSX Registry (prompts for PAT)."
    },
    "publish_vscode": {
      "label": "\ud83d\udecd\ufe0f Publish MS Marketplace",
      "command": "npm run publish:vscode",
      "tooltip": "Publish packaged VSIX artifact to Microsoft VS Code Marketplace (prompts for VSCE_PAT)."
    },
    "publish": {
      "label": "\ud83d\ude80 Dual Publish (All)",
      "command": "npm run publish:all",
      "tooltip": "Package once and publish identical VSIX to both Open VSX and Microsoft VS Code Marketplace."
    },
    "checkin": {
      "command": "git add . && git commit -m 'wip' && git push",
      "label": "Checkin"
    },
    "server": {
      "command": "npm run watch",
      "label": "Start Server"
    },
    "deploy": {
      "command": "npm run compile && npx @vscode/vsce package",
      "label": "Deploy"
    }
  }
}